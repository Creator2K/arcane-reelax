{
  "name": "arcane-reelax",
  "version": "0.26.1",
  "private": true,
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,admin -c cyan,magenta \"npm run dev -w server\" \"npm run dev -w web\"",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "seed": "npm run seed -w server",
    "build": "npm run build -w server && npm run build -w web",
    "start": "npm run start -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:generate": "npm run db:generate -w server",
    "test": "npm run test -w server && node scripts/verify-assets.mjs && node scripts/verify-current-frontend.mjs",
    "verify:assets": "node scripts/verify-assets.mjs",
    "predev": "npm run build -w web",
    "dev:admin": "npm run dev -w web",
    "audit:ui": "node scripts/audit-ui.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.19.12": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "argon2@0.41.1": true
  }
}
